{
  "name": "cider-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name cider",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate:glyph-slices": "node scripts/slice-glyph.mjs",
    "generate:glyph-atlas": "node scripts/generate_glyph_atlas.ts",
    "generate:glyphs": "npm run generate:glyph-slices && npm run generate:glyph-atlas",
    "glyph:self-test": "npm run generate:glyph-atlas && tsx scripts/glyph_decoder.ts self-test",
    "glyph:trace": "npm run generate:glyph-atlas && tsx scripts/glyph_decoder.ts trace",
    "glyph:decode": "tsx scripts/glyph_decoder.ts decode",
    "glyph:benchmark": "tsx scripts/glyph_decoder.ts benchmark",
    "glyph:fuzz": "tsx scripts/glyph_decoder_fuzz.ts",
    "ocr:line": "tsx scripts/ocr_line.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "sharp": "0.35.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
